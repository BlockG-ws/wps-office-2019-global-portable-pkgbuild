[Desktop Entry]
Name=WPS PDF
Name[zh_CN]=WPS PDF
GenericName=Kingsoft Pdf Reader
GenericName[zh_CN]=WPS PDF
Comment=Kingsoft Office suite
Exec=env PORTABLE_CONF=com.wps.Office portable --forward-file -- wpspdf %F
TryExec=portable
